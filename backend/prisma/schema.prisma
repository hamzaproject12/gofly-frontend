generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Hiérarchie : AGENT < ADMIN < GERANT < SUPER_ADMIN.
/// Les règles associées sont centralisées dans src/services/roleService.ts.
enum Role {
  ADMIN
  AGENT
  GERANT
  SUPER_ADMIN
}

enum LedgerType {
  ACHAT_PACK
  CONSOMMATION
  REMBOURSEMENT
  AJUSTEMENT
  BONUS
}

/// Portefeuille de crédits prépayés de l'agence (singleton : une seule ligne, 1 crédit = 1 pèlerin).
model Wallet {
  id        Int            @id @default(autoincrement())
  balance   Int            @default(0)
  updatedAt DateTime       @updatedAt @map("updated_at")
  ledger    CreditLedger[]
}

/// Historique append-only des mouvements de crédits : jamais modifié ni supprimé.
model CreditLedger {
  id            Int        @id @default(autoincrement())
  walletId      Int
  type          LedgerType
  amount        Int
  balanceAfter  Int
  reservationId Int?
  packLabel     String?    @db.VarChar(100)
  paymentRef    String?    @db.VarChar(200)
  note          String?    @db.Text
  createdBy     String     @db.VarChar(200)
  createdAt     DateTime   @default(now()) @map("created_at")
  wallet        Wallet     @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([createdAt])
}

enum ReservationType {
  LIT
  CHAMBRE_PRIVEE
}

model Agent {
  id                Int                  @id @default(autoincrement())
  nom               String               @db.VarChar(100)
  email             String?              @unique
  motDePasse        String               @db.VarChar(255)
  role              Role                 @default(AGENT)
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  payments          Payment[]
  expenses          Expense[]
  reservations      Reservation[]
  fixedCharges      FixedCharge[]
  journalActions    JournalSuppression[]
}

/// Journal append-only des suppressions et désactivations (traçabilité admin).
model JournalSuppression {
  id                Int      @id @default(autoincrement())
  createdAt         DateTime @default(now()) @map("created_at")
  actorId           Int?
  actorRoleSnapshot String   @db.VarChar(20)
  action            String   @db.VarChar(80)
  entityType        String   @db.VarChar(40)
  entityId          Int?
  summary           String?  @db.VarChar(500)
  detailText        String   @db.Text
  /// Libellé affiché dans la colonne « Par » (ex. agent assigné à la réservation, ou agent métier)
  parDisplay        String?  @db.VarChar(200) @map("par_display")
  actor             Agent?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@map("JournalSuppression")
}

enum FixedChargeCategory {
  LOYER
  SALAIRE
  CHARGES_DIVERSES
  AUTRE
}

model FixedCharge {
  id          Int                 @id @default(autoincrement())
  label       String              @db.VarChar(200)
  amount      Float
  category    FixedChargeCategory
  agentId     Int?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  agent       Agent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)
  occurrences FixedChargeOccurrence[]

  @@index([isActive])
}

model FixedChargeOccurrence {
  id            Int         @id @default(autoincrement())
  fixedChargeId Int
  yearMonth     String      @db.VarChar(7)
  amount        Float
  expenseId     Int         @unique
  generatedAt   DateTime    @default(now()) @map("generated_at")
  fixedCharge   FixedCharge @relation(fields: [fixedChargeId], references: [id], onDelete: Restrict)
  expense       Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([fixedChargeId, yearMonth])
}

enum ProgramStatus {
  ACTIF
  CLOTURE
  ARCHIVE
}

/// Origine du prix de vente d'un programme.
/// GRILLE : prix de la brochure publiée, saisi formule par formule
/// (ProgramFormulePrix). C'est le SEUL mode de vente : il n'est plus choisi dans
/// l'interface, tout programme est vendu au prix de sa grille.
/// CALCUL : ancien prix dérivé du vol + visa + hôtels + profit. Conservé pour les
/// seuls programmes antérieurs à la grille qui n'en ont pas encore reçu une :
/// enregistrer leur grille les bascule en GRILLE et ils n'en reviennent plus.
/// Le calcul lui-même reste vivant comme ESTIMATION DU COÛT (aide à la décision),
/// jamais comme prix de vente.
enum PricingMode {
  CALCUL
  GRILLE
}

model Program {
  id               Int                  @id @default(autoincrement())
  name             String               @db.VarChar(150)
  created_at       DateTime             @default(now()) @map("created_at")
  status           ProgramStatus        @default(ACTIF)
  dateCloture      DateTime?
  dateArchivage    DateTime?
  dateDepart       DateTime?
  dateArrivee      DateTime?
  /// Heures de vol au format "HH:mm". Stockees en texte et non dans dateDepart /
  /// dateArrivee : une heure locale d'aeroport n'a pas de fuseau, la ranger dans un
  /// TIMESTAMP la ferait glisser d'une heure a chaque conversion UTC.
  heureDepart      String?              @db.VarChar(5)
  heureArrivee     String?              @db.VarChar(5)
  visaDeadline     DateTime?
  hotelDeadline    DateTime?
  flightDeadline   DateTime?
  passportDeadline DateTime?
  exchange         Float                @default(1.0)
  nbJoursMadina    Int                  @default(0)
  nbJoursMakkah    Int                  @default(0)
  prixAvionDH      Float                @default(0)
  prixVisaRiyal    Float                @default(0)
  profit           Float                @default(0)
  profitEconomique Float                @default(0)
  profitNormal     Float                @default(0)
  profitVIP        Float                @default(0)
  /// Origine du prix de vente : GRILLE pour tout nouveau programme. Le défaut a
  /// changé (il valait CALCUL le temps de la mise en place de la grille) ; les
  /// lignes déjà écrites ne bougent pas pour autant, d'où la bascule au démarrage
  /// des programmes qui portent déjà une grille (cf. basculerProgrammesAvecGrille).
  pricingMode      PricingMode          @default(GRILLE)
  isDeleted        Boolean              @default(false)
  deletedAt        DateTime?
  expenses         Expense[]
  hotelsMadina     ProgramHotelMadina[]
  hotelsMakkah     ProgramHotelMakkah[]
  hotelsAutre      ProgramHotelAutre[]
  formules         ProgramFormule[]
  reservations     Reservation[]
  rooms            Room[]
  payments         Payment[]
}

/// Une LIGNE de la grille tarifaire (brochure) : une combinaison d'hôtels vendue
/// sous un libellé, ex. « Al Markaziya + Abraj Al Kiswah ». Le nombre de formules
/// varie d'un programme à l'autre.
model ProgramFormule {
  id        Int                    @id @default(autoincrement())
  programId Int
  label     String                 @db.VarChar(200)
  /// Mention libre affichée sous le libellé (« + petit-déjeuner », « 400 m du Haram »).
  note      String?                @db.VarChar(300)
  ordre     Int                    @default(0)
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")
  program   Program                @relation(fields: [programId], references: [id], onDelete: Cascade)
  hotels    ProgramFormuleHotel[]
  prix      ProgramFormulePrix[]
  reservations Reservation[]

  @@index([programId, ordre])
}

/// Hôtels AUTORISÉS par une formule. Plusieurs lignes pour une même ville
/// expriment un choix (« Emaar Grand OU Diyafat Al Rajaa ») ; la ville est portée
/// par l'hôtel lui-même (Hotel.city), comme partout ailleurs dans le schéma.
model ProgramFormuleHotel {
  id        Int            @id @default(autoincrement())
  formuleId Int
  hotelId   Int
  formule   ProgramFormule @relation(fields: [formuleId], references: [id], onDelete: Cascade)
  hotel     Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([formuleId, hotelId])
  @@index([hotelId])
}

/// Une CASE de la brochure : prix de vente par personne, en dirhams entiers.
/// Une case « — » (non proposée) est l'ABSENCE de ligne, jamais un prix à 0 :
/// 0 DH resterait un prix valide (place offerte), il ne peut pas signifier « pas
/// de prix ». Entier obligatoire — un prix de brochure n'a pas de centimes.
model ProgramFormulePrix {
  id        Int            @id @default(autoincrement())
  formuleId Int
  roomType  RoomType
  prixVente Int
  formule   ProgramFormule @relation(fields: [formuleId], references: [id], onDelete: Cascade)

  @@unique([formuleId, roomType])
}

model Hotel {
  id             Int                   @id @default(autoincrement())
  name           String                @db.VarChar(150)
  city           City
  programsMadina ProgramHotelMadina[]
  programsMakkah ProgramHotelMakkah[]
  programsAutre  ProgramHotelAutre[]
  formules       ProgramFormuleHotel[]
  rooms          Room[]

  @@unique([name, city])
}

model ProgramHotelMadina {
  id        Int     @id @default(autoincrement())
  programId Int
  hotelId   Int
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, hotelId])
}

model ProgramHotelMakkah {
  id        Int     @id @default(autoincrement())
  programId Int
  hotelId   Int
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, hotelId])
}

model ProgramHotelAutre {
  id        Int     @id @default(autoincrement())
  programId Int
  hotelId   Int
  nbJours   Int     @default(0)
  ordre     Int     @default(0)
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, hotelId])
}

model Room {
  id                  Int      @id @default(autoincrement())
  programId           Int
  hotelId             Int
  roomType            RoomType
  gender              String
  nbrPlaceTotal       Int
  nbrPlaceRestantes   Int
  prixRoom            Float
  listeIdsReservation Int[]
  created_at          DateTime @default(now()) @map("created_at")
  updated_at          DateTime @updatedAt @map("updated_at")
  hotel               Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  program             Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model Reservation {
  id              Int       @id @default(autoincrement())
  firstName       String
  lastName        String
  phone           String
  programId       Int
  roomType        RoomType
  hotelMadina     String?
  hotelMakkah     String?
  hotelsAutre     Json?
  price           Float
  paidAmount      Float     @default(0)
  status          String    @default("Incomplet") @db.VarChar(50)
  statutPasseport Boolean   @default(false)
  statutVisa      Boolean   @default(false)
  statutHotel     Boolean   @default(false)
  statutVol       Boolean   @default(false)
  reservationDate DateTime
  created_at      DateTime  @default(now()) @map("created_at")
  updated_at      DateTime  @updatedAt @map("updated_at")
  gender          String    @default("Homme")
  agentId         Int?
  reduction       Float     @default(0)
  plan            String    @default("Normal") @db.VarChar(20)
  passportNumber  String?   @db.VarChar(50)
  transport       String?   @db.VarChar(100)
  remarque        String?   @db.Text
  groupe          String?   @db.VarChar(100)
  typeReservation ReservationType @default(LIT)
  isLeader        Boolean         @default(true)
  parentId        Int?
  groupId         String?         @db.VarChar(64)
  familyMixed     Boolean         @default(false)
  roomSlot        Int?
  /// Formule de la grille tarifaire vendue. Null pour un programme en mode CALCUL
  /// ou pour un dossier hors grille.
  formuleId       Int?
  /// Libellé de la formule FIGÉ à la vente. Indispensable : remplacer la grille
  /// d'un programme supprime ses formules, ce qui remet `formuleId` à NULL —
  /// sans ce libellé, on ne saurait plus ce qui a été vendu.
  formuleLabel    String?         @db.VarChar(200)
  /// Prix de la grille PAR PERSONNE au moment de la vente, en dirhams entiers.
  /// Instantané figé : modifier la grille ensuite ne touche aucun dossier existant.
  prixGrille      Int?
  /// Dossier volontairement sorti de la grille par un ADMIN : hôtels et prix libres.
  horsGrille      Boolean         @default(false)
  expenses        Expense[]
  documents       Fichier[]
  payments        Payment[]
  agent           Agent?    @relation(fields: [agentId], references: [id])
  program         Program   @relation(fields: [programId], references: [id])
  formule         ProgramFormule? @relation(fields: [formuleId], references: [id], onDelete: SetNull)
  parent          Reservation?  @relation("ReservationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  accompagnants   Reservation[] @relation("ReservationHierarchy")

  @@index([parentId])
  @@index([groupId])
  @@index([formuleId])
}

model Fichier {
  id            Int         @id @default(autoincrement())
  reservationId Int
  fileType      String
  fileName      String
  storedName    String
  filePath      String
  uploaded_at   DateTime    @default(now()) @map("uploaded_at")
  fileCategory  String
  cloudinaryId  String?     // ID du fichier sur Cloudinary
  cloudinaryUrl String?     // URL du fichier sur Cloudinary
  expenses      Expense[]
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  payment       Payment?
}

model Payment {
  id            Int          @id @default(autoincrement())
  reservationId Int?
  /// Libellé saisi manuellement (paiement sans dossier ou complément d’info)
  description   String?      @db.Text
  amount        Float
  paymentMethod String
  paymentDate   DateTime     @default(now())
  fichierId     Int?         @unique
  programId     Int?
  agentId       Int?
  agent         Agent?       @relation(fields: [agentId], references: [id], onDelete: Restrict)
  fichier       Fichier?     @relation(fields: [fichierId], references: [id])
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  program       Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
}

model Expense {
  id                    Int                    @id @default(autoincrement())
  description           String
  amount                Float
  date                  DateTime               @default(now())
  programId             Int?
  type                  String
  fichierId             Int?
  reservationId         Int?
  agentId               Int?
  agent                 Agent?                 @relation(fields: [agentId], references: [id], onDelete: SetNull)
  fichier               Fichier?               @relation(fields: [fichierId], references: [id])
  program               Program?               @relation(fields: [programId], references: [id])
  reservation           Reservation?           @relation(fields: [reservationId], references: [id])
  fixedChargeOccurrence FixedChargeOccurrence?
}



enum RoomType {
  SINGLE
  DOUBLE
  TRIPLE
  QUAD
  QUINT
}

enum Status {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum City {
  Madina
  Makkah
  Autre
}